    {
      "parameters": {
        "jsCode": "// See code-nodes/merge-ai-personalization.js for annotated version\n// Parses AI JSON output and promotes personalized fields onto the item.\n// Falls back to safe defaults on parse error.\n\nfunction parsePersonalization(raw) {\n  if (!raw) return { email: '', linkedin: '' };\n  const cleaned = String(raw).replace(/```json|```/g, '').trim();\n  try {\n    const obj = JSON.parse(cleaned);\n    return {\n      email:    (obj.email    || '').trim(),\n      linkedin: (obj.linkedin || '').trim(),\n    };\n  } catch {\n    return {\n      email:    'Your work in this space stood out to us.',\n      linkedin: 'your sector',\n    };\n  }\n}\n\nreturn items.map(item => {\n  const p = parsePersonalization(item.json.output);\n  const { output, ...rest } = item.json;\n  return {\n    json: {\n      ...rest,\n      personalized_email:    p.email,\n      personalized_linkedin: p.linkedin,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -352
      ],
      "id": "b2b4f352-4786-49b6-b796-ecccf2ffad63",
      "name": "Parse Personalization"
    },
    {
      "parameters": {
        "jsCode": "// Step 1: Normalize — rename non-canonical headers to canonical names\nconst fieldMap = {\n  'Pitchbook':        'pitchbook_url',\n  'Url':              'website_url',\n  'Email':            'email',\n  'Founder Linkedin': 'linkedin_url',\n  'About':            'about',\n  'Date Added':       'date_added',\n  'Contacted':        'contacted_at',\n};\n\nreturn items.map(item => {\n  const merged = { ...item.json };\n  for (const [old, canonical] of Object.entries(fieldMap)) {\n    if (old in merged) {\n      if (!(canonical in merged) || merged[canonical] === '' || merged[canonical] === null) {\n        merged[canonical] = merged[old];\n      }\n      delete merged[old];\n    }\n  }\n  return { json: merged };\n});"
      },
